generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id          Int               @id @default(autoincrement())
  first_name       String            @db.VarChar(100)
  last_name        String            @db.VarChar(100)
  email            String            @unique @db.VarChar(150)
  password_hash    String            @db.VarChar(255)
  phone            String?           @db.VarChar(20)
  role             String            @default("user") @db.VarChar(20)
  reputation_score Decimal?          @default(0.00) @db.Decimal(3, 2)
  wallet_balance   Decimal?          @default(0.00) @db.Decimal(10, 2)
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @default(now()) @updatedAt @db.Timestamp(6)

  // Relations
  kyc_verification KycVerification?
  bought_trades    Transaction[]     @relation("BuyerTrades")
  sold_trades      Transaction[]     @relation("SellerTrades")
  listings         Listing[]         @relation("UserListings")
  raised_disputes  Dispute[]         @relation("RaisedDisputes")
  handled_disputes Dispute[]         @relation("HandledDisputes")
  messages         Message[]
  audit_logs       AuditLog[]
  notifications    Notification[]

  @@map("users")
}

model KycVerification {
  kyc_id     Int        @id @default(autoincrement())
  user_id    Int        @unique
  user       User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  id_type    String     @db.VarChar(50)
  id_number  String     @db.VarChar(100)
  id_name    String     @db.VarChar(150)
  birthdate  DateTime   @db.Date
  status     String?    @default("pending") @db.VarChar(20)
  
  images     KycImage[]

  @@map("kyc_verification")
}

model KycImage {
  image_id    Int             @id @default(autoincrement())
  kyc_id      Int
  kyc         KycVerification @relation(fields: [kyc_id], references: [kyc_id], onDelete: Cascade)
  image_type  String          @db.VarChar(20)
  file_path   String          @db.VarChar(255)
  uploaded_at DateTime?       @default(now()) @db.Timestamp(6)

  @@map("kyc_image")
}

model Transaction {
  transaction_id    Int       @id @default(autoincrement())
  buyer_id          Int
  buyer             User      @relation("BuyerTrades", fields: [buyer_id], references: [user_id])
  seller_id         Int
  seller            User      @relation("SellerTrades", fields: [seller_id], references: [user_id])
  item_type         String?   @db.VarChar(100)
  game_type         String?   @db.VarChar(50)
  account_credentials String? @db.Text
  agreed_price      Decimal   @db.Decimal(10, 2)
  service_fee       Decimal   @db.Decimal(10, 2)
  total_amount      Decimal   @db.Decimal(10, 2)
  status            String?   @default("pending") @db.VarChar(20)
  inspection_hours  Int?
  item_delivered_at DateTime? @db.Timestamp(6)
  buyer_approved_at DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  payment           Payment?
  dispute           Dispute?
  messages          Message[]
  audit_logs        AuditLog[]

  @@map("transactions")
}

model Payment {
  payment_id     Int         @id @default(autoincrement())
  transaction_id Int         @unique
  transaction    Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)
  amount         Decimal     @db.Decimal(10, 2)
  payment_method String      @db.VarChar(20)
  vault_status   String?     @default("held") @db.VarChar(20)
  deposit_date   DateTime?   @db.Timestamp(6)
  release_date   DateTime?   @db.Timestamp(6)
  refund_date    DateTime?   @db.Timestamp(6)
  created_at     DateTime    @default(now()) @db.Timestamp(6)

  @@map("payment")
}

model Dispute {
  dispute_id           Int         @id @default(autoincrement())
  transaction_id       Int         @unique
  transaction          Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)
  raised_by            Int
  raiser               User        @relation("RaisedDisputes", fields: [raised_by], references: [user_id])
  dispute_type         String?     @db.VarChar(100)
  description          String?     @db.Text
  evidence_screenshots String?     @db.Text
  resolution           String?     @db.VarChar(20)
  raised_at            DateTime?   @default(now()) @db.Timestamp(6)
  resolved_at          DateTime?   @db.Timestamp(6)
  handled_by           Int?
  handler              User?       @relation("HandledDisputes", fields: [handled_by], references: [user_id])

  @@map("dispute")
}

model Message {
  message_id          Int         @id @default(autoincrement())
  transaction_id      Int
  transaction         Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)
  sender_id           Int
  sender              User        @relation(fields: [sender_id], references: [user_id])
  message_text        String?     @db.Text
  sent_at             DateTime?   @default(now()) @db.Timestamp(6)
  is_system_generated Boolean?    @default(false)
  risk_level          String?     @db.VarChar(20)

  @@map("message")
}

model AuditLog {
  log_id             Int         @id @default(autoincrement())
  transaction_id     Int
  transaction        Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)
  user_id            Int
  user               User        @relation(fields: [user_id], references: [user_id])
  action_type        String?     @db.VarChar(100)
  action_description String?     @db.Text
  ip_address         String?     @db.VarChar(45)
  timestamp          DateTime?   @default(now()) @db.Timestamp(6)
  risk_score         Decimal?    @db.Decimal(5, 2)

  @@map("audit_log")
}

model Listing {
  listing_id      Int       @id @default(autoincrement())
  seller_id       Int
  seller          User      @relation("UserListings", fields: [seller_id], references: [user_id], onDelete: Cascade)
  game_type       String    @db.VarChar(50)
  item_name       String    @db.VarChar(100)
  price           Decimal   @db.Decimal(10, 2)
  status          String    @default("open") @db.VarChar(20)
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  @@map("listing")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  user_id         Int
  user            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  message         String   @db.Text
  type            String   @db.VarChar(50)
  is_read         Boolean  @default(false)
  reference_id    Int?
  created_at      DateTime @default(now()) @db.Timestamp(6)

  @@map("notification")
}
