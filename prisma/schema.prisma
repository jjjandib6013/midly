generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id                  Int                 @id @default(autoincrement())
  first_name               String              @db.VarChar(100)
  last_name                String              @db.VarChar(100)
  email                    String              @unique @db.VarChar(150)
  password_hash            String              @db.VarChar(255)
  phone                    String?             @db.VarChar(20)
  role                     String              @default("user") @db.VarChar(20)
  reputation_score         Decimal?            @default(0.00) @db.Decimal(3, 2)
  wallet_balance           Decimal?            @default(0.00) @db.Decimal(10, 2)
  birthdate                DateTime?           @db.Date
  reset_password_token     String?             @db.VarChar(255)
  reset_password_expires   DateTime?           @db.Timestamp(6)
  created_at               DateTime            @default(now()) @db.Timestamp(6)
  updated_at               DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  email_verification_token String?             @db.VarChar(255)
  is_email_verified        Boolean             @default(false)
  is_banned                Boolean             @default(false)
  accounts                 Account[]
  audit_logs               AuditLog[]
  handled_disputes         Dispute[]           @relation("HandledDisputes")
  raised_disputes          Dispute[]           @relation("RaisedDisputes")
  kyc_verification         KycVerification?
  listings                 Listing[]           @relation("UserListings")
  messages                 Message[]
  notifications            Notification[]
  sessions                 Session[]
  bought_trades            Transaction[]       @relation("BuyerTrades")
  sold_trades              Transaction[]       @relation("SellerTrades")
  payment_methods          UserPaymentMethod[]
  wallet_transactions      WalletTransaction[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@map("sessions")
}

model UserPaymentMethod {
  method_id    Int      @id @default(autoincrement())
  user_id      Int
  provider     String   @db.VarChar(50)
  account_mask String   @db.VarChar(20)
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_payment_methods")
}

model KycVerification {
  kyc_id           Int        @id @default(autoincrement())
  user_id          Int        @unique
  id_type          String     @db.VarChar(100)
  id_number        String     @db.VarChar(255)
  id_name          String     @db.VarChar(255)
  birthdate        DateTime?  @db.Date
  status           String?    @default("pending") @db.VarChar(50)
  phase            Int        @default(1)
  face_descriptor  Float[]    @default([])
  rejection_reason String?    @db.VarChar(255)
  match_distance   Float?
  ocr_raw_text     String?
  images           KycImage[]
  user             User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("kyc_verification")
}

model KycImage {
  image_id    Int             @id @default(autoincrement())
  kyc_id      Int
  image_type  String          @db.VarChar(20)
  file_path   String          @db.VarChar(255)
  file_hash   String?         @db.VarChar(64)
  uploaded_at DateTime?       @default(now()) @db.Timestamp(6)
  kyc         KycVerification @relation(fields: [kyc_id], references: [kyc_id], onDelete: Cascade)

  @@map("kyc_image")
}

model Transaction {
  transaction_id      Int        @id @default(autoincrement())
  buyer_id            Int
  seller_id           Int
  item_type           String?    @db.VarChar(100)
  game_type           String?    @db.VarChar(50)
  trade_category      String?    @default("Game Account") @db.VarChar(50)
  item_name           String?    @db.VarChar(255)
  account_credentials String?
  agreed_price        Decimal    @db.Decimal(10, 2)
  service_fee         Decimal    @db.Decimal(10, 2)
  total_amount        Decimal    @db.Decimal(10, 2)
  status              String?    @default("pending") @db.VarChar(20)
  inspection_hours    Int?
  item_delivered_at   DateTime?  @db.Timestamp(6)
  buyer_approved_at   DateTime?  @db.Timestamp(6)
  cancel_requested_by Int?
  created_at          DateTime   @default(now()) @db.Timestamp(6)
  updated_at          DateTime   @default(now()) @updatedAt @db.Timestamp(6)
  audit_logs          AuditLog[]
  dispute             Dispute?
  messages            Message[]
  payment             Payment?
  buyer               User       @relation("BuyerTrades", fields: [buyer_id], references: [user_id])
  seller              User       @relation("SellerTrades", fields: [seller_id], references: [user_id])

  @@map("transactions")
}

model Payment {
  payment_id     Int         @id @default(autoincrement())
  transaction_id Int         @unique
  amount         Decimal     @db.Decimal(10, 2)
  payment_method String      @db.VarChar(20)
  vault_status   String?     @default("held") @db.VarChar(20)
  deposit_date   DateTime?   @db.Timestamp(6)
  release_date   DateTime?   @db.Timestamp(6)
  refund_date    DateTime?   @db.Timestamp(6)
  created_at     DateTime    @default(now()) @db.Timestamp(6)
  transaction    Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)

  @@map("payment")
}

model Dispute {
  dispute_id           Int         @id @default(autoincrement())
  transaction_id       Int         @unique
  raised_by            Int
  dispute_type         String?     @db.VarChar(100)
  description          String?
  evidence_screenshots String?
  resolution           String?     @db.VarChar(20)
  raised_at            DateTime?   @default(now()) @db.Timestamp(6)
  resolved_at          DateTime?   @db.Timestamp(6)
  handled_by           Int?
  handler              User?       @relation("HandledDisputes", fields: [handled_by], references: [user_id])
  raiser               User        @relation("RaisedDisputes", fields: [raised_by], references: [user_id])
  transaction          Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)

  @@map("dispute")
}

model Message {
  message_id          Int         @id @default(autoincrement())
  transaction_id      Int
  sender_id           Int
  message_text        String?
  sent_at             DateTime?   @default(now()) @db.Timestamp(6)
  is_system_generated Boolean?    @default(false)
  risk_level          String?     @db.VarChar(20)
  sender              User        @relation(fields: [sender_id], references: [user_id])
  transaction         Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)

  @@map("message")
}

model AuditLog {
  log_id             Int         @id @default(autoincrement())
  transaction_id     Int
  user_id            Int
  action_type        String?     @db.VarChar(100)
  action_description String?
  ip_address         String?     @db.VarChar(45)
  timestamp          DateTime?   @default(now()) @db.Timestamp(6)
  risk_score         Decimal?    @db.Decimal(5, 2)
  transaction        Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)
  user               User        @relation(fields: [user_id], references: [user_id])

  @@map("audit_log")
}

model Listing {
  listing_id Int      @id @default(autoincrement())
  seller_id  Int
  game_type  String   @db.VarChar(50)
  item_name  String   @db.VarChar(100)
  price      Decimal  @db.Decimal(10, 2)
  status     String   @default("open") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)
  seller     User     @relation("UserListings", fields: [seller_id], references: [user_id], onDelete: Cascade)

  @@map("listing")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  user_id         Int
  type            String   @db.VarChar(50)
  message         String
  is_read         Boolean  @default(false)
  reference_id    Int?
  created_at      DateTime @default(now()) @db.Timestamp(6)
  user            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("notifications")
}

model PlatformSettings {
  id                       Int      @id @default(1)
  base_fee                 Decimal  @default(0.05) @db.Decimal(5, 4)
  kyc_biometric_threshold  Float    @default(0.55)
  kyc_review_threshold     Float    @default(0.45)
  updated_at               DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("platform_settings")
}

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  user_id     Int
  type        String   @db.VarChar(50) 
  amount      Decimal  @db.Decimal(10, 2)
  balance     Decimal  @db.Decimal(10, 2)
  description String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  user        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("wallet_transactions")
}
